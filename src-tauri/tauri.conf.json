{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyPilot",
  "version": "0.3.2",
  "identifier": "app.proxypilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProxyPilot 代理分流助手",
        "width": 980,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ProxyPilot",
    "shortDescription": "代理分流助手",
    "longDescription": "只让选中的应用和网站走本机代理，其余流量直连。",
    "license": "GPL-3.0-only",
    "resources": {
      "../LICENSE": "licenses/LICENSE.txt",
      "resources/sing-box-LICENSE.txt": "licenses/sing-box-LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMDVFQ0M2RkQ1MTgwQjIKUldTeWdGSDl4dXdGN0JpUDdsaDF3d216V0txNjhNWDBFSlQyMVB6MzNFNU5aTk1UMUJNdG0vSVcK",
      "endpoints": ["https://github.com/dongtl/ProxyPilot/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
